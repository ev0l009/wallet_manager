class WalletError(Exception):
    """Base exception for all application errors."""

# Branch 1: Persistence & Stored File Integrity (Startup / Disk failures)
class StorageReadError(WalletError):
    """OS read failure or malformed JSON syntax in storage.json."""

class StorageWriteError(WalletError):
    """Failed to serialize, fsync, or atomically replace storage.json."""

class DataIntegrityError(WalletError):
    """Stored file parsed as JSON, but violates schema, field, or timeline invariants."""

# Branch 2: Rejected User Actions / Business Rule Violations (Recoverable in UI)
class BusinessRuleError(WalletError):
    """Base class for user actions rejected by domain/business rules."""

class InvalidCategoryError(BusinessRuleError):
    """Invalid or misplaced expense category (BR-20)."""

class ReversalError(BusinessRuleError):
    """Invalid reversal attempt (e.g., reversing a reversal or already-reversed transaction)."""

class NegativeBalanceError(BusinessRuleError):
    """Proposed transaction or reversal would push an account timeline below zero."""
    def __init__(self, account_id: str, date: str, balance: int) -> None:
        self.account_id = account_id
